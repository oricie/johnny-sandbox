{
  "display_information": {
    "name": "Johnny",
    "description": "Design agent that learns from your team and improves the product",
    "background_color": "#4a154b"
  },
  "features": {
    "bot_user": {
      "display_name": "Johnny",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/johnny",
        "description": "Ask Johnny to review the product or handle a request",
        "usage_hint": "review | <your request>",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "commands",
        "channels:history",
        "channels:read",
        "groups:history",
        "groups:read",
        "files:write",
        "reactions:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
