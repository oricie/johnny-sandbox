{
  "display_information": {
    "name": "Johnny",
    "description": "Design agent that learns from your team and improves the product",
    "background_color": "#4a154b"
  },
  "features": {
    "bot_user": {
      "display_name": "Johnny",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/johnny",
        "description": "Ask Johnny to review the product or handle a request",
        "usage_hint": "review | <your request>",
        "should_escape": false
      }
    ],
    "assistant_view": {
      "assistant_description": "Johnny learns from your product, code and team conversations, finds what to improve, and builds it.",
      "suggested_prompts": [
        {
          "title": "Review the product",
          "message": "review"
        },
        {
          "title": "Why is containment locked?",
          "message": "Why can only an incident lead isolate a host?"
        },
        {
          "title": "Request a change",
          "message": "Add a way to filter the alert queue by source"
        }
      ]
    },
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "commands",
        "channels:history",
        "channels:read",
        "groups:history",
        "groups:read",
        "files:write",
        "reactions:write",
        "users:read",
        "assistant:write",
        "im:history",
        "im:read",
        "im:write",
        "files:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups",
        "assistant_thread_started",
        "assistant_thread_context_changed",
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
